{
  "name": "companygraph-obsidian-plugin",
  "version": "0.8.0",
  "private": true,
  "description": "CompanyGraph in Obsidian: checks an instance as it is edited and completes what its schemas declare",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "fixtures": "node scripts/fixtures.mjs",
    "pretest": "node scripts/fixtures.mjs",
    "test": "node --test 'test/*.test.ts'",
    "e2e": "node scripts/fixtures.mjs && node esbuild.config.mjs && node --test --test-concurrency=1 'e2e/*.e2e.ts'",
    "e2e:coverage": "rm -rf e2e/coverage && E2E_COVERAGE=1 npm run e2e && node scripts/e2e-coverage.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.config.mjs",
    "notices": "node scripts/notices.mjs"
  },
  "dependencies": {
    "companygraph-meta-model": "github:companygraph/meta-model#v0.42.0",
    "markdownlint": "0.41.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "obsidian-launcher": "3.2.1",
    "typescript": "^7.0.2"
  }
}
